# ── Ports hôte ──────────────────────────────────────────────────────────────
# 5000 est occupé par AirPlay Receiver sur macOS : penser à le surcharger dans ton .env.
API_PORT=5000
FRONT_PORT=3000

# ── LLM ─────────────────────────────────────────────────────────────────────
# À RENSEIGNER (hub LLM), ne pas laisser vide
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODEL=chat
OPENAI_VLM_MODEL_NAME=mistral-small-3.1-24b-instruct-2503
MAX_CONTEXT_SIZE=128000
MAX_MODEL_TOKEN=128000
MAX_CONCURRENCY_LLM_CALL=5
TOKENIZER_MODEL_NAME=gpt-4
HF_TOKEN=

# ── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:secret@db:5432/example_db

# ── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_NAME=redis-queue
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_SERVICE_NAME=mymaster
REDIS_SENTINEL_PASSWORD=
CELERY_APP_NAME=default

# ── Stockage objet ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=test
MINIO_BUCKET_NAME=test
MINIO_END_POINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_AVAILABLE=False
MINIO_AVAILABLE=True

# ── Sécurité API ────────────────────────────────────────────────────────────
# keycloak | full-access (dev, sans auth) | dev. En local, docker-compose
VERIFY_TOKEN_MODEL=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=your-client-id
# À RENSEIGNER hors dev local — secret.
KEYCLOAK_CLIENT_SECRET=

# ── OCR ─────────────────────────────────────────────────────────────────────
# OCR_SERVICE_LLM=LLM pour utiliser le VLM au lieu de l'API externe
# Staging : https://mirai-ocr-staging.sdid-app.cpin.numerique-interieur.com/
OCR_SERVICE_LLM=
OCR_BACKEND_URL=localhost:8000

# ── OpenWebUI external document loader (optionnel) ──────────────────────────
# Si la clé est vide, /process n'est pas authentifié.
EXTERNAL_DOCUMENT_LOADER_API_KEY=
EXTERNAL_LOADER_POLL_INTERVAL_SECONDS=2
EXTERNAL_LOADER_MAX_WAIT_SECONDS=600

# ── LLM Guard (service commenté dans docker-compose) ────────────────────────
LLM_GUARD_API_KEY=llm_guard
LLM_GUARD_URL=http://llm_guard_api:8000

# ── Divers ──────────────────────────────────────────────────────────────────
PYPANDOC_PANDOC_FOLDER=/app/pandoc
# CACHE_FOLDER=/app/.cache

# ── Observabilité ───────────────────────────────────────────────────────────
SERVICE_NAME=ocr_worker
ENVIRONMENT=development
SENTRY_API_DSN=
SENTRY_WORKER_DSN=
SEND_DEFAULT_PII=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local

# ── Frontend (Vite) — exposé au navigateur, jamais de secret ────────────────
NODE_ENV=development
VITE_ENVIRONMENT=development
VITE_SSO_BYPASS=false
VITE_PORTAIL_URL=https://mirai.interieur.gouv.fr
VITE_USER_REVIEW_URL=https://grist.numerique.gouv.fr/o/miraigrist/forms/mwak44At8FPopKoX45hMaj/76
VITE_TCHAP_CANAL_URL='https://tchap.gouv.fr/#/room/%21uTmmquZyqzVNkBGvdb:agent.interieur.tchap.gouv.fr?via=agent.interieur.tchap.gouv.fr'
VITE_MATOMO_SITE_URL=https://matomo-dev.sdid-app.cpin.numerique-interieur.com
VITE_MATOMO_SITE_ID=11
VITE_SENTRY_FRONTEND_DSN=
VITE_KEYCLOAK_URL=https://mirai-sso-dev.mirai-hp.cpin.numerique-interieur.com
VITE_KEYCLOAK_CLIENT_ID=abrege
VITE_KEYCLOAK_REALM=mirai
VITE_REDIRECT_URI=http://localhost:8082

# ── Tests E2E — secrets, à renseigner dans ton .env local ───────────────────
VITE_USERNAME_KEYCLOAK=
VITE_PASSWORD_KEYCLOAK=
