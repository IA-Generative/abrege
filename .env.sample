# ────────────────────────────────────────────────────────────────────────────
# LLM / OpenAI-compatible API  (REQUIRED)
# ────────────────────────────────────────────────────────────────────────────
# OPENAI_API_BASE_URL is required — there is no fallback to the public OpenAI API, to
# avoid silently sending requests (and the API key) there. Deprecated name: OPENAI_API_BASE.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
# OPENAI_API_MODEL / OPENAI_VLM_MODEL_NAME default to the LLM hub's generic "chat" alias,
# which the hub remaps to whichever concrete engine is live — set a concrete model name
# here only when talking directly to a provider (e.g. a local Ollama), not through a hub.
OPENAI_API_MODEL=qwen2.5
OPENAI_VLM_MODEL_NAME=chat  # Used when OCR_SERVICE_LLM=LLM
MAX_CONTEXT_SIZE=128000

# Optional per-feature overrides for the side extractions dispatched alongside the summary
# (see docs/document-insights.md) — each defaults to OPENAI_API_MODEL (the summary's own
# model) when left unset. Only set one if that feature should use a different model.
QA_MODEL_NAME=
ENTITY_MODEL_NAME=   # also used for the global-relationships pass
CHUNK_MODEL_NAME=
TOPIC_MODEL_NAME=

# ────────────────────────────────────────────────────────────────────────────
# Database  (REQUIRED)
# ────────────────────────────────────────────────────────────────────────────
# In Docker Compose use the service name as host, e.g. @db:5432
DATABASE_URL=postgresql://postgres:secret@localhost:5432/example_db

# ────────────────────────────────────────────────────────────────────────────
# Redis / Celery broker  (REQUIRED)
# ────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_NAME=redis-queue
REDIS_PASSWORD=             # Optional — leave empty for no auth
REDIS_TLS=false             # Set to true to use rediss:// (TLS)
# Sentinel (optional) — REDIS_SENTINEL_ENABLED is the explicit toggle; if left unset,
# sentinel mode is inferred from the presence of REDIS_SENTINEL_HOSTS.
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_HOSTS=       # e.g. sentinel1:26379,sentinel2:26379
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_PASSWORD=    # Optional — auth for the sentinel nodes themselves; falls back to REDIS_PASSWORD

# ────────────────────────────────────────────────────────────────────────────
# Object storage  (REQUIRED) — S3-compatible (works with MinIO via AWS_ENDPOINT_URL)
# ────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1

# ────────────────────────────────────────────────────────────────────────────
# API security  (REQUIRED in production)
# ────────────────────────────────────────────────────────────────────────────
# Values: keycloak | full-access (dev, no auth) | dev (static dev tokens)
# In "keycloak" mode, the browser never talks to Keycloak directly (BFF pattern, see
# docs/security/readme.md): the backend owns the OAuth2 Authorization Code + PKCE flow via
# /api/auth/{login,callback,logout,me}, and the browser only gets an opaque, httpOnly,
# Secure-in-production session cookie. A Bearer token is still accepted for
# service-to-service calls (e.g. the SDK), verified via Keycloak introspection.
VERIFY_TOKEN_MODEL=keycloak
KEYCLOAK_URL=http://localhost:8080
# Browser-facing issuer URL, only needed when it differs from KEYCLOAK_URL (e.g. local
# docker compose, where the backend reaches Keycloak via the service name).
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=master
# Must be a confidential client (publicClient: false): only the backend exchanges the
# authorization code, the browser never authenticates against Keycloak directly.
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=secret
# Public URL of this API — used to build the fixed redirect_uri sent to Keycloak
# ({BACKEND_PUBLIC_URL}/api/auth/callback), which must match a registered client redirect URI.
BACKEND_PUBLIC_URL=http://localhost:5000
# Public URL of the frontend — required CORS origin, post-login/post-logout redirect target.
FRONTEND_URL=http://localhost:8082
# BFF session cookie — the defaults below are already correct for an HTTPS deployment.
SESSION_COOKIE_NAME=abrege_session
SESSION_COOKIE_SECURE=true          # Never disable in production — only for local HTTP dev
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800          # 7 days, capped by the Keycloak refresh token's own expiry

# Shared secret the abrege_service worker uses to call the internal (worker-only)
# CRUD routes on the API — POST /task/{id}/qa, /entities, /relationships/global.
INTERNAL_SERVICE_TOKEN=change-me
# Where abrege_service reaches the API from inside the docker network.
ABREGE_API_BASE_URL=http://abrege_api:5000

# ────────────────────────────────────────────────────────────────────────────
# OCR service  (optional — default: external OCR API)
# ────────────────────────────────────────────────────────────────────────────
# Set to "LLM" to use the VLM-based OCR instead of the external API
OCR_SERVICE_LLM=
OCR_BACKEND_URL=https://mirai-ocr-staging.sdid-app.cpin.numerique-interieur.com/
# Required (unless OCR_SERVICE_LLM=LLM): how the worker authenticates against the OCR
# service above. A static key is preferred — no Keycloak dependency for what is otherwise
# just a call to a sibling batch service. Provisioned as a per-consumer key on the ocr side
# (its KeycloakToken.verify() already tries a static API_KEYS match before introspection).
OCR_API_KEY=
# Fallback (only used when OCR_API_KEY is unset): the KEYCLOAK_* client credentials from
# the "API security" section above (client-credentials grant), or a service account
# provisioned as a regular Keycloak user via OCR_KEYCLOAK_USERNAME/OCR_KEYCLOAK_PASSWORD
# (Resource Owner Password Credentials — still needs KEYCLOAK_URL/CLIENT_ID/REALM).
OCR_KEYCLOAK_USERNAME=
OCR_KEYCLOAK_PASSWORD=

# ────────────────────────────────────────────────────────────────────────────
# Worker / Celery  (optional)
# ────────────────────────────────────────────────────────────────────────────
CELERY_APP_NAME=default
MAX_CONCURRENCY_LLM_CALL=5

# ────────────────────────────────────────────────────────────────────────────
# Caches & temp files  (optional)
# ────────────────────────────────────────────────────────────────────────────
CACHE_FOLDER=/app/.cache/url
PYPANDOC_PANDOC_FOLDER=      # Override pandoc binary location (auto-detected if empty)

# ────────────────────────────────────────────────────────────────────────────
# Observability  (optional)
# ────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development      # development | production | testing
SENTRY_API_DSN=
SENTRY_WORKER_DSN=
SEND_DEFAULT_PII=false
# Langfuse (optionnel — désactivé si LANGFUSE_PUBLIC_KEY est vide)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
