{
  "name": "frontend",
  "type": "module",
  "version": "3.5.0-rc.4",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "clean:dist": "rimraf dist",
    "build-only": "vite build",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "cd .. && husky apps/client/.husky",
    "preview": "vite preview",
    "test": "run-s test:unit test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e-ci": "playwright test",
    "test:e2e-ui": "playwright test --ui",
    "type-check": "vue-tsc --build --force || exit 0",
    "generate-openapi": "pnpx openapi-typescript ${VITE_ABREGE_API_URL}/openapi.json -o ./src/api/types/api.schema.d.ts"
  },
  "dependencies": {
    "@gouvfr/dsfr": "~1.14.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@sentry/vue": "^10.77.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/components": "^15.0.0",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "focus-trap": "^8.2.4",
    "focus-trap-vue": "^4.1.0",
    "graphology": "^0.26.0",
    "husky": "^9.1.7",
    "marked": "^18.1.2",
    "pinia": "^4.1.0",
    "sigma": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-matomo": "^4.2.0",
    "vue-router": "^5.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "workbox-window": "^7.4.1"
  }
}
