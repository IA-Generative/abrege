# Valeurs par défaut d'EXEMPLE pour le dev local via docker compose (aucun secret réel).
# Pour surcharger : créer un .env (ignoré par git), il est chargé après ce fichier.

# Backend / worker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_QUEUE_NAME=redis-queue
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://rustfs:9000
AWS_DEFAULT_REGION=us-east-1
DATABASE_URL=postgresql://postgres:secret@db:5432/example_db
OPENAI_API_KEY=sk-example-change-me
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_API_MODEL=qwen2.5
MAX_CONCURRENCY_LLM_CALL=5
MAX_MODEL_TOKEN=16300
CELERY_APP_NAME=default
INTERNAL_SERVICE_TOKEN=change-me

# Frontend
FRONT_PORT=3000

VITE_ABREGE_API_URL=http://localhost:5000/api

VITE_PORTAIL_URL=https://example.com/portail
VITE_USER_REVIEW_URL=https://example.com/review
VITE_TCHAP_CANAL_URL=https://example.com/tchap

#KEYCLOAK (BFF : le backend seul parle à Keycloak, cf. docs/security/readme.md)
# Aligné sur docker/keycloak/realm-mirai.json (realm importé au démarrage du compose)
KEYCLOAK_URL=http://keycloak:8080
# URL vue par le navigateur (le backend, lui, passe par le nom de service ci-dessus)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=abrege
KEYCLOAK_REALM=mirai
KEYCLOAK_CLIENT_SECRET=dev-only-secret-not-for-prod
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8082
# Dev local en HTTP : un cookie "Secure" n'est pas conservé, la session ne tient pas et le login boucle
SESSION_COOKIE_SECURE=false

VITE_USERNAME_KEYCLOAK=test@gouv.fr
VITE_PASSWORD_KEYCLOAK=example-password
