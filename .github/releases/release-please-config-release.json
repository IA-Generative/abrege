{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "versioning": "prerelease",
      "prerelease": false,
      "prerelease-type": "",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/server/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "path": "apps/server/uv.lock",
          "type": "toml",
          "jsonpath": "$.package[?(@.name.value=='abrege')].version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "toml",
          "path": "sdk/python/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "sdk/python/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='abrege-sdk')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance Improvements",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Code Refactoring",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Dependencies",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous Chores",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Continuous Integration",
          "hidden": true
        }
      ]
    }
  }
}
