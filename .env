# KEYCLOAK (BFF : le navigateur ne parle jamais à Keycloak, seul le backend le fait - voir
# docs/security/readme.md). KEYCLOAK_URL est joint backend-to-container (échange de code,
# introspection, refresh) ; KEYCLOAK_PUBLIC_URL est l'adresse vers laquelle le navigateur
# est redirigé pour se connecter. Ces valeurs pointent vers le service `keycloak` du
# docker-compose local (realm/client/utilisateur de test auto-provisionnés, voir
# docker/keycloak/realm-mirai.json) — à remplacer par un Keycloak réel hors dev local.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=mirai
KEYCLOAK_CLIENT_ID=abrege
KEYCLOAK_CLIENT_SECRET=dev-only-secret-not-for-prod
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8082
# Dev local en HTTP simple : jamais `false` dès que le trafic passe par HTTPS (production).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Tests E2E
VITE_USERNAME_KEYCLOAK=test@gouv.fr
VITE_PASSWORD_KEYCLOAK='qJ"jZ>>_:B5u$BG'

# LOGGING PYTHON
SERVICE_NAME=ocr_worker # Possible values: ocr_worker, ocr_api
ENVIRONMENT=development # Possible values: development, production
OCR_BACKEND_URL=localhost:8000

OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX